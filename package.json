{
	"name": "snapshot",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.25.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e",
		"check": "biome check .",
		"check:fix": "biome check --write --unsafe .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format --write .",
		"test:e2e:web": "pnpm --filter @snapshot/web test:e2e:web"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"@nestjs/core",
			"esbuild",
			"sharp",
			"@parcel/watcher"
		],
		"overrides": {
			"brace-expansion": ">=5.0.9",
			"browserslist": ">=4.28.7",
			"esbuild": ">=0.25.0",
			"fast-uri": ">=3.1.6",
			"js-yaml": ">=4.3.1",
			"qs": ">=6.16.0",
			"undici": ">=7.29.0 <8"
		},
		"patchedDependencies": {
			"next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "10.0.1",
		"@snapshot/config": "workspace:*",
		"semantic-release": "25.0.9",
		"turbo": "2.10.12",
		"typescript": "5.9.3"
	}
}
