# Snapshot — deployment configuration.
#
# This file is read by `docker compose up -d`, and by nothing else. Copy it and
# fill in the four required values:
#
#   cp .env.example .env
#
# Local development does not need this file. `pnpm dev` runs against
# `compose.dev.yml` on built-in defaults — see docs/development.md.

# ── Required ─────────────────────────────────────────────────────────────────

# The public origin your users open — your nginx vhost, e.g. https://img.example.com
# Every share, raw and delete URL is built from it, so a wrong value here writes
# broken links into ShareX.
BASE_URL=

# Signs the session cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
SESSION_SECRET=

# Encrypts stored authenticator secrets. At least 32 characters, generated
# independently of SESSION_SECRET. Changing it locks out every enrolled
# authenticator, so keep it stable once it is set.
MFA_ENCRYPTION_KEY=

# Password for the Postgres container compose starts for you. Compose builds the
# connection string from it — you never write one yourself.
POSTGRES_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────────
# Everything below already has the value shown. Uncomment only to change it.

# Which image tag to run. Pin a release to control when you upgrade.
#SNAPSHOT_TAG=latest

# Network interface the dashboard (:3000) and API (:3001) are published on.
# The default keeps both on loopback, where only your nginx can reach them. Use
# 0.0.0.0 only if the proxy runs on another host and a firewall guards the ports.
#BIND_ADDRESS=127.0.0.1

# trace | debug | info | warn | error | fatal
#LOG_LEVEL=info

# Sign out after this many hours without activity.
#SESSION_TTL_HOURS=24

# Hard cap on a session's age however active it is. At least SESSION_TTL_HOURS.
#SESSION_ABSOLUTE_TTL_HOURS=168

# argon2id password hashing cost. Raise only if you know what you are trading.
#ARGON2_TIME_COST=3
#ARGON2_MEMORY_COST=65536
#ARGON2_PARALLELISM=4
